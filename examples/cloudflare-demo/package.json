{
  "name": "workflow-cloudflare-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:up": "docker run -d --name workflow-demo-pg -e POSTGRES_PASSWORD=pw -e POSTGRES_DB=workflow -p 54320:5432 postgres:17 && pnpm db:init",
    "db:init": "node scripts/db-init.mjs",
    "db:down": "docker rm -f workflow-demo-pg",
    "db:reset": "pnpm db:down; pnpm db:up",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@shware/workflow": "workspace:*",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  }
}
