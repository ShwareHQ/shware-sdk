{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workflow-engine-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workflows": [
    {
      "name": "journey",
      "binding": "JOURNEY",
      "class_name": "DemoJourneyRunner",
    },
  ],
  // The engine's Postgres. Locally, `pnpm db:up` starts it in docker and wrangler dev connects
  // straight to it; deployed, the Hyperdrive id names the real database.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "<hyperdrive id>",
      "localConnectionString": "postgres://postgres:pw@localhost:54320/workflow",
    },
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "send_email": [{ "name": "EMAIL" }],
  // Development runs open (no API_TOKEN) and in fast-forward; production needs `wrangler secret put API_TOKEN`
  "vars": { "ENVIRONMENT": "development" },
  "triggers": { "crons": ["*/15 * * * *"] },
}
