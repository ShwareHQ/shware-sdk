{
  "name": "@shware/workflow",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShwareHQ/shware-sdk.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./engine": {
      "import": {
        "types": "./dist/engine/index.d.mts",
        "default": "./dist/engine/index.mjs"
      },
      "require": {
        "types": "./dist/engine/index.d.cts",
        "default": "./dist/engine/index.cjs"
      }
    },
    "./cloudflare": {
      "import": {
        "types": "./dist/cloudflare/index.d.mts",
        "default": "./dist/cloudflare/index.mjs"
      },
      "require": {
        "types": "./dist/cloudflare/index.d.cts",
        "default": "./dist/cloudflare/index.cjs"
      }
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --type-aware src tests --fix"
  },
  "dependencies": {
    "@types/ms": "^2.1.0",
    "ms": "^2.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
