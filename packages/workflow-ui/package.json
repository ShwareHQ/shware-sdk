{
  "name": "@shware/workflow-ui",
  "version": "2.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShwareHQ/shware-sdk.git"
  },
  "bin": {
    "workflow-ui": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.mts",
        "default": "./dist/config.mjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/postgres.d.mts",
        "default": "./dist/postgres.mjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsdown",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --type-aware src tests --fix"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-email/render": "^2.1.1",
    "@shware/workflow": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.45",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "i18next": "^26.4.7",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.59.0",
    "react-i18next": "^17.0.20",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vite-plugin-svgr": "^5.2.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@tanstack/react-query-devtools": "^5.104.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "country-flag-icons": "^1.6.20",
    "jsdom": "^30.1.3",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "postgres": ">=3.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    }
  }
}
