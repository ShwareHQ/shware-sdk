{
  "name": "@shware/workflow-ui",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShwareHQ/shware-sdk.git"
  },
  "bin": {
    "workflow-ui": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "src/app"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.mts",
        "default": "./dist/config.mjs"
      }
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --type-aware src --fix"
  },
  "dependencies": {
    "@react-email/render": "^2.1.0",
    "@shware/workflow": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^1.30.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
