{
  "name": "@shware/security",
  "version": "8.0.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShwareHQ/shware-sdk.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./oauth2/provider": {
      "import": {
        "types": "./dist/oauth2/provider/index.d.mts",
        "default": "./dist/oauth2/provider/index.mjs"
      },
      "require": {
        "types": "./dist/oauth2/provider/index.d.cts",
        "default": "./dist/oauth2/provider/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsdown",
    "test": "vitest run",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.typetests.json",
    "lint": "oxlint --type-aware src --fix"
  },
  "dependencies": {
    "@shware/utils": "workspace:^",
    "cookie": "^2.0.1",
    "jose": "^6.2.13",
    "path-to-regexp": "^8.4.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.6.5",
    "ioredis": "^6.0.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "ioredis": "^6.0.0",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  }
}
